<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>P2P 60-24 EVO — Repository Audit & Cleanup Report</title>
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body { font-family: 'Monaco', 'Consolas', monospace; background: #0d1117; color: #e6edf3; line-height: 1.6; }
        .container { max-width: 1200px; margin: 0 auto; padding: 40px 20px; }
        header { border-bottom: 2px solid #21262d; padding-bottom: 20px; margin-bottom: 30px; }
        h1 { color: #58a6ff; font-size: 2.5em; margin-bottom: 10px; }
        h2 { color: #79c0ff; font-size: 1.8em; margin: 30px 0 15px 0; border-left: 4px solid #58a6ff; padding-left: 15px; }
        h3 { color: #a5d6ff; font-size: 1.3em; margin: 20px 0 10px 0; }
        .timestamp { color: #8b949e; font-size: 0.9em; }
        .section { background: #161b22; border: 1px solid #21262d; border-radius: 6px; padding: 20px; margin: 20px 0; }
        table { width: 100%; border-collapse: collapse; margin: 15px 0; }
        th, td { text-align: left; padding: 12px; border-bottom: 1px solid #21262d; }
        th { background: #0d1117; color: #79c0ff; font-weight: bold; }
        tr:hover { background: #1c2128; }
        .status-pass { color: #3fb950; font-weight: bold; }
        .status-warn { color: #d29922; font-weight: bold; }
        .status-fail { color: #f85149; font-weight: bold; }
        .code-block { background: #0d1117; border-left: 3px solid #21262d; padding: 15px; margin: 15px 0; overflow-x: auto; }
        code { color: #79c0ff; }
        .metric { display: inline-block; background: #1c2128; padding: 10px 15px; margin: 5px; border-radius: 4px; border-left: 3px solid #58a6ff; }
        .stat-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 15px; margin: 20px 0; }
        .stat-card { background: #1c2128; border: 1px solid #21262d; padding: 15px; border-radius: 4px; text-align: center; }
        .stat-value { color: #79c0ff; font-size: 2em; font-weight: bold; }
        .stat-label { color: #8b949e; font-size: 0.9em; margin-top: 5px; }
        .checklist { list-style: none; padding: 0; }
        .checklist li { padding: 8px 0; padding-left: 25px; position: relative; }
        .checklist li:before { content: "✓"; color: #3fb950; font-weight: bold; position: absolute; left: 0; }
        .checklist li.pending:before { content: "◯"; color: #8b949e; }
        .checklist li.issue:before { content: "✗"; color: #f85149; }
        .action-item { background: #261d26; border-left: 4px solid #d29922; padding: 15px; margin: 10px 0; border-radius: 4px; }
        .next-steps { background: #1f6feb; padding: 20px; border-radius: 6px; margin: 20px 0; }
        .command { background: #0d1117; padding: 12px; margin: 10px 0; border-radius: 4px; border-left: 3px solid #58a6ff; font-family: 'Monaco', monospace; }
        .success { color: #3fb950; }
        .warning { color: #d29922; }
        .error { color: #f85149; }
    </style>
</head>
