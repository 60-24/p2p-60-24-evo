        <!-- PUSH INSTRUCTIONS -->
        <section class="section">
            <h2>📤 Push Instructions</h2>

            <h3>Option 1: SSH (Recommended, if available)</h3>
            <div class="command">
cd /home/claude/p2p-60-24-evo<br>
git remote set-url origin git@github.com:P2P-60-24/p2p-60-24-evo.git<br>
git push -u origin main
            </div>

            <h3>Option 2: HTTPS with Personal Access Token</h3>
            <div class="command">
cd /home/claude/p2p-60-24-evo<br>
git remote set-url origin https://[token]@github.com/P2P-60-24/p2p-60-24-evo.git<br>
git push -u origin main
            </div>

            <h3>Option 3: GitHub CLI</h3>
            <div class="command">
cd /home/claude/p2p-60-24-evo<br>
gh repo sync P2P-60-24/p2p-60-24-evo
            </div>

            <h3>Verify Push Success</h3>
            <div class="command">
git log --oneline -5<br>
git remote -v<br>
# Should show origin pointing to GitHub<br>
git branch -vv<br>
# Should show 'main' tracking 'origin/main'
            </div>
        </section>

